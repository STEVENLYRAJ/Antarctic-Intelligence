# Copy to .env (never commit .env). None of these are required for the default pipeline,
# which uses only public data (NOAA/NSIDC CDR v6, NCEP/NCAR R1).

# Copernicus Climate Data Store (ERA5) - ML-01: optional ERA5 atmosphere; ML-02: designated primary temperature source
# (ML-02 runs on interim NCEP/NCAR R1 until this is set). Accept the ERA5 licences on the CDS website first.
# Alternatively create ~/.cdsapirc with:  url: https://cds.climate.copernicus.eu/api  /  key: <your-token>
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# Copernicus Marine (OSI SAF SIC CDR, sea-ice drift) - `copernicusmarine login` stores credentials locally
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=

# NASA Earthdata (NSIDC DAAC products such as NSIDC-0803) - or use ~/.netrc
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# API service
AETHENTRA_API_PORT=8000
